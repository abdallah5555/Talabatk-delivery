{
  "expo": {
    "name": "طلباتك دليفري",
    "slug": "talabatk-delivery",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "talabatk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      ["expo-location", { "locationWhenInUsePermission": "طلباتك دليفري يحتاج موقع المندوب أثناء الوردية لتحديث التوصيل وتتبع الطلب." }],
      ["expo-notifications", { "color": "#e8590c", "defaultChannel": "orders" }],
      ["react-native-google-mobile-ads", { "androidAppId": "ca-app-pub-3630733404130483~6106030269", "optimizeInitialization": true, "optimizeAdLoading": true }]
    ],
    "android": {
      "package": "com.talabatk.delivery",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": { "typedRoutes": true }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3630733404130483~6106030269"
  }
}
