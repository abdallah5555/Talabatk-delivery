{
  "expo": {
    "name": "طلباتك دليفري",
    "slug": "talabatk-delivery",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/1a617642-b1c4-4a68-8fa5-98c0ad3c7911",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "1a617642-b1c4-4a68-8fa5-98c0ad3c7911"
      }
    },
    "orientation": "portrait",
    "scheme": "talabatk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      ["expo-image-picker", { "photosPermission": "طلباتك يحتاج الوصول للصور لاختيار اللوجو والصورة الشخصية وصور المستندات.", "cameraPermission": "طلباتك يحتاج الكاميرا لتصوير اللوجو والصورة الشخصية والمستندات.", "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "طلباتك يحتاج موقعك لتحديد موقع النشاط ولتحديث موقع المندوب أثناء الوردية." }],
      ["expo-notifications", { "color": "#e8590c", "defaultChannel": "orders" }],
      ["react-native-google-mobile-ads", { "androidAppId": "ca-app-pub-3630733404130483~6106030269", "optimizeInitialization": true, "optimizeAdLoading": true }]
    ],
    "android": {
      "package": "com.talabatk.delivery",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": { "typedRoutes": true }
  }
}
