# Free/configurable map style. Do not point this at a paid provider unless the user explicitly changes policy.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional public web base URL for deep links / PWA deployment.
# Codex should set this after the NEW Vercel project is created.
