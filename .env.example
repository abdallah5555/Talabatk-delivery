EXPO_PUBLIC_SUPABASE_URL=https://vriwhtuxagnbfxybjviz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3NRqWSIZd3KnxVKQ0ngRyg_IvqLZ0aO

# Public app configuration
