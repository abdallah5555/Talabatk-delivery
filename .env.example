# Browser-safe Supabase configuration only.
# Never place SUPABASE_SERVICE_ROLE_KEY or other privileged secrets in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public app configuration
VITE_APP_NAME=طلباتك دليفري
VITE_APP_ENV=development

# Server/Edge-only secrets must be configured in the hosting/Supabase secret store,
# never committed to this repository.
